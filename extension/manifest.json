{
  "manifest_version": 3,
  "name": "Truth Lens - Misinformation Verification",
  "version": "1.2.0",
  "description": "Truth Lens - AI-assisted misinformation and cyber threat verification for web pages.",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*.replit.dev/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Open Truth Lens"},
  "side_panel": {"default_path": "sidepanel.html"},
  "content_scripts": [{"matches":["<all_urls>"],"js":["content.js"],"run_at":"document_idle"}]
}